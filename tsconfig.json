{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true,
    "esModuleInterop": true, "skipLibCheck": true, "declaration": true,
    "paths": { "@/*": ["./src/*"] }, "types": ["react", "react-dom", "node"], "resolveJsonModule": true
  },
  "include": ["src", "site", "vite.site.config.ts"]
}
